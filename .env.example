# Copy this file to .env and fill in real values — .env is gitignored and
# should never be committed. This file documents the required shape only;
# none of the values below are real.

# Paystack (TEST keys — from https://dashboard.paystack.com/#/settings/developers)
# Secret key stays server-side only — deliberately NOT prefixed with VITE_
# so Vite never bundles it into client-side JS.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public key is safe for the browser and needs the VITE_ prefix so Vite
# exposes it via import.meta.env in client code.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (from https://app.supabase.com/project/_/settings/api)
# The anon key is meant to be public-facing (enforced by Row Level Security
# policies on the Supabase side), so both of these also use the VITE_ prefix.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
