# Copy this file to .env and fill in real values — .env is gitignored and
# should never be committed. This file documents the required shape only;
# none of the values below are real.

# Paystack (TEST keys — from https://dashboard.paystack.com/#/settings/developers)
# Secret key stays server-side only — deliberately NOT prefixed with VITE_
# so Vite never bundles it into client-side JS.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (from https://app.supabase.com/project/_/settings/api)
# The anon key is meant to be public-facing (enforced by Row Level Security
# policies on the Supabase side), so both of these also use the VITE_ prefix.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Service role key (Dashboard -> Settings -> API -> service_role). Bypasses
# Row Level Security entirely — used only by api/ serverless functions
# (never the browser), so deliberately not VITE_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Direct Postgres connection (Dashboard -> Settings -> Database -> Connection
# string). For manual local use only (e.g. running a migration by hand with
# psql) — no script in this repo reads it, and it does not need to be set
# in Vercel at all.
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Resend (https://resend.com/api-keys) — sends every team alert email (new
# leads, signups, paid and recovered orders). Server-side only. Without this
# (and ORDER_ALERT_EMAIL below) set, alerts are silently skipped — the
# underlying record is still saved either way, but nobody gets notified.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Where team alerts are sent. Comma-separated for more than one address.
ORDER_ALERT_EMAIL=team@luxecard.co.ke
# Optional. Defaults to onboarding@resend.dev (Resend's own sandbox sender,
# which only delivers to the Resend account owner) until a real domain is
# verified in Resend.
# ALERT_FROM_EMAIL=LuxeCard <alerts@luxecard.co.ke>
# Optional. Defaults to luxecardke@gmail.com. Overridden per-email anyway
# for anything that should reply straight to the customer instead (e.g. a
# business enquiry) — this is only the fallback for alerts that don't set
# their own replyTo.
# ALERT_REPLY_TO=team@luxecard.co.ke

# Protects api/reconcile-orders.ts, the daily cron job that recovers any
# paid order the webhook missed. Vercel sends this automatically as
# `Authorization: Bearer <value>` for scheduled invocations once it's set
# as an env var — generate any long random string (e.g. `openssl rand -hex
# 32`) and set the same value here and in Vercel.
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Meta Pixel + Conversions API (optional: leave unset and no Meta code loads
# or runs). Tracking only ever happens for visitors who accept the cookie
# banner.
# Pixel ID (Events Manager -> Data sources -> your Pixel). Public, so VITE_-
# prefixed for the browser; the server's Conversions API reads it too.
VITE_META_PIXEL_ID=000000000000000
# Conversions API access token (Events Manager -> Settings -> Generate access
# token). Server-side only, deliberately NOT VITE_-prefixed.
META_CAPI_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: while testing, paste the code from Events Manager -> Test events
# so server events show up there. Remove it for live traffic.
META_TEST_EVENT_CODE=
